# Esta es solo una plantilla. No la uses directamente en producción.
# Copia este archivo a ".env" y coloca tus credenciales reales de Supabase.
# Usa la URL del proyecto y la clave publicable/anon de la sección API Keys.
# No uses la clave service_role ni la clave secreta.

# Ejemplo real:
# VITE_SUPABASE_URL=https://abc123.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publicable_xxx...
# VITE_APP_URL=http://localhost:5178

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=http://localhost:5178
